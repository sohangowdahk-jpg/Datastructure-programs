
<!DOCTYPE html>
<html>
<head>
    <title>Student Freelance Hub</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f4f4ff;
            text-align: center;
        }

        header {
            background: #29245c;
            color: white;
            padding: 20px;
        }

        nav {
            background: #413b80;
            padding: 12px;
        }

        nav a {
            color: white;
            margin: 15px;
            text-decoration: none;
        }

        .hero {
            padding: 50px 20px;
        }

        .hero h1 {
            color: #29245c;
        }

        button {
            background: orange;
            padding: 12px 25px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        .services {
            background: white;
            padding: 30px;
        }
    </style>
</head>

<body>

<header>
    <h1>Student Freelance Hub</h1>
    <p>Skills Today. Success Tomorrow.</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
</nav>

<section class="hero" id="home">
    <h1>Turn Your Skills Into Opportunities!</h1>
    <p>Connect talented students with businesses
       looking for creative services.</p>
    <button onclick="joinHub()">
        Join Now
    </button>
</section>

<section class="services" id="services">
    <h2>Our Services</h2>
    <p>Graphic Designing | Web Development</p>
    <p>Video Editing | Photography</p>
    <p>Content Writing | Social Media Management</p>
</section>

<section id="about">
    <h2>About Us</h2>
    <p>We help students showcase their skills
       and gain real-world freelance experience.</p>
</section>

<script>
    function joinHub() {
        alert("Welcome to Student Freelance Hub!");
    }
</script>

</body>
</html>
